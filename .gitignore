out-tsc/
tmp/
bazel-out/
coverage/
test-results/
playwright-report/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular cache
.angular/

# IDEs
.idea/
.vscode/
.history/
*.sublime-workspace
*.sw?

# OS files
.DS_Store
Thumbs.db

