# ============================================
# Cardápio Digital SAAS — Backend Environment
# ============================================
# Copie este arquivo como .env e preencha os valores.
# NUNCA versione o .env com valores reais.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Servidor ---
PORT=3000
NODE_ENV=development
DEPLOYMENT_ENV=development
# Produção/staging: ref exata no host https://<ref>.supabase.co
EXPECTED_SUPABASE_PROJECT_REF=
# Obrigatório em staging: ref real do projeto de produção, que deve ser diferente
PRODUCTION_SUPABASE_PROJECT_REF=
TRUST_PROXY=false

# --- Segurança ---
APP_MODE=
FRONTEND_ORIGINS=http://localhost:4200
# Canonical QR origin. Production requires an explicit HTTPS origin in FRONTEND_ORIGINS.
# Changing this origin invalidates already printed links unless the old domain remains routed.
PUBLIC_MENU_ORIGIN=http://localhost:4200
ADMIN_ORIGINS=http://localhost:4300
# Staging: ADMIN_ORIGINS=https://admin-staging.pingochef.com
# Produção: ADMIN_ORIGINS=https://admin.pingochef.com
INVITATION_HASH_SECRET=
ADMIN_LOGIN_HASH_SECRET=
OWNER_SESSION_ENCRYPTION_KEY=

# Menu analytics: dedicated HMAC key (32+ random characters) recommended.
# If empty, a domain-separated HMAC uses OWNER_SESSION_ENCRYPTION_KEY.
# Rotation changes anonymous identities; coordinate rotations with report interpretation.
ANALYTICS_HASH_SECRET=
ANALYTICS_IP_EVENTS_PER_MINUTE=1500
ANALYTICS_SESSION_EVENTS_PER_MINUTE=180
# Emergency pause for public browser batches only (confirmed likes remain authoritative).
ANALYTICS_COLLECTION_ENABLED=true
# Retention/history/timezone are configured in analytics_settings; see docs/21.
OWNER_AUTH_CALLBACK_URL=http://localhost:3000/api/v1/auth/confirm-email
# Optional fixed ISO UTC cutoff, at most 14 days; leave empty to disable legacy import.
OWNER_LEGACY_TOKEN_ACCEPT_UNTIL=
INTERNAL_JOBS_SECRET=
PURGE_STORAGE_BUCKET=
API_TELEMETRY_ENABLED=false
ACTIVATION_TOKEN_SECRET=
LIKE_HASH_SECRET=
LIKE_RATE_LIMIT=20
LIKE_RATE_WINDOW_SECONDS=60
LIKE_IP_RATE_LIMIT=30
LIKE_IP_RATE_WINDOW_SECONDS=3600

# --- Vídeos / Mux (somente backend) ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SIGNING_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
MUX_TEST_MODE=false
VIDEO_MAX_DURATION_SECONDS=15
VIDEO_MAX_UPLOAD_BYTES=52428800
VIDEO_UPLOAD_URL_TTL_SECONDS=900
VIDEO_DAILY_UPLOAD_LIMIT=20
VIDEO_MAX_PENDING_UPLOADS=3
VIDEO_UPLOAD_RATE_LIMIT=5
VIDEO_UPLOAD_RATE_WINDOW_SECONDS=900
VIDEO_UPLOAD_ALLOWED_ORIGINS=http://localhost:4200
VIDEO_IP_HASH_SECRET=
VIDEO_RECONCILIATION_SECRET=
VIDEO_RECONCILIATION_BATCH_SIZE=50
VIDEO_WEBHOOK_CLAIM_STALE_SECONDS=300
VIDEO_PLAYBACK_TOKEN_TTL_SECONDS=120
VIDEO_PLAYBACK_RATE_LIMIT=20
VIDEO_PLAYBACK_RATE_WINDOW_SECONDS=60
